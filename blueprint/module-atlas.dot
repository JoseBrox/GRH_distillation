digraph proof {
graph [rankdir=TB, bgcolor="white", pad="0.24", nodesep="0.30", ranksep="0.48",
  fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Complete manuscript section-reference atlas\nArrows mean cites; this is not a proof DAG", splines=polyline];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
  margin="0.18,0.12", penwidth=1.3];
edge [color="#64748B", penwidth=1.1, arrowsize=0.65];
graph [nodesep="0.15", ranksep="0.32"];
node [fontsize=9, margin="0.12,0.08"];
edge [color="#B2BBC5", penwidth=0.6, arrowsize=0.4];
subgraph "cluster_analytic_criterion" {
