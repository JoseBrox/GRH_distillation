digraph proof {
graph [rankdir=TB, bgcolor="white", pad="0.24", nodesep="0.30", ranksep="0.48",
  fontname="DejaVu Sans", fontsize=12, labelloc=t, label="A shorter route toward Dirichlet GRH", splines=polyline];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
  margin="0.18,0.12", penwidth=1.3];
edge [color="#64748B", penwidth=1.1, arrowsize=0.65];
"qrh" [label="Uniform quasi-RH\nCited input", fillcolor="#E8F0FC", color="#3566A0", fontcolor="#173D70"];
"choices" [label="Choose auxiliary characters\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"cohomology" [label="Cohomology bounds\nPartly completed", fillcolor="#FFF1CC", color="#A66B0B", fontcolor="#694400"];
"maps" [label="Integral theta maps\nPartly completed", fillcolor="#FFF1CC", color="#A66B0B", fontcolor="#694400"];
"norms" [label="Norm and divisibility bounds\nPartly completed", fillcolor="#FFF1CC", color="#A66B0B", fontcolor="#694400"];
"assembly" [label="Compare the same integral objects\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"prime_sum" [label="Required prime-sum bound\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"criterion" [label="One-sided zero criterion\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"grh" [label="Dirichlet GRH\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"qrh" -> "choices";
"choices" -> "maps";
"maps" -> "norms";
"maps" -> "assembly";
"cohomology" -> "assembly";
"norms" -> "assembly";
"assembly" -> "prime_sum";
"prime_sum" -> "criterion";
"criterion" -> "grh";
{rank=same; "choices"; "cohomology";}
{rank=same; "maps"; "norms";}
}
