digraph proof {
graph [rankdir=TB, bgcolor="white", pad="0.24", nodesep="0.30", ranksep="0.48",
  fontname="DejaVu Sans", fontsize=12, labelloc=t, label="A proof-wide route toward Dirichlet GRH", splines=polyline];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
  margin="0.18,0.12", penwidth=1.3];
edge [color="#64748B", penwidth=1.1, arrowsize=0.65];
"inputs" [label="Classical inputs and uniform quasi-RH\nCited input", fillcolor="#E8F0FC", color="#3566A0", fontcolor="#173D70"];
"arithmetic" [label="Characters, cohomology and Galois representations\nPartly completed", fillcolor="#FFF1CC", color="#A66B0B", fontcolor="#694400"];
"theta" [label="Integral theta maps\nPartly completed", fillcolor="#FFF1CC", color="#A66B0B", fontcolor="#694400"];
"geometry" [label="Geometric lower slope and discarded-degree budget\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"global_norms" [label="Global theta identities and norm bounds\nPartly completed", fillcolor="#FFF1CC", color="#A66B0B", fontcolor="#694400"];
"compatible" [label="Compatible arithmetic data with controlled average losses\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"bound" [label="Required prime-sum bound\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"criterion" [label="One-sided zero criterion\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"grh" [label="Dirichlet GRH\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"inputs" -> "arithmetic";
"arithmetic" -> "theta";
"theta" -> "global_norms";
"arithmetic" -> "compatible";
"theta" -> "compatible";
"geometry" -> "compatible";
"global_norms" -> "compatible";
"compatible" -> "bound";
"bound" -> "criterion";
"criterion" -> "grh";
{rank=same; "arithmetic"; "geometry";}
{rank=same; "theta"; "global_norms";}
}
