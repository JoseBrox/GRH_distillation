digraph proof {
graph [rankdir=TB, bgcolor="white", pad="0.24", nodesep="0.30", ranksep="0.48",
  fontname="DejaVu Sans", fontsize=12, labelloc=t, label="Ordinary RH: from arithmetic estimates to zeros of zeta\n6/9 nodes written or cited — stated hypotheses remain necessary", splines=polyline];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
  margin="0.18,0.12", penwidth=1.3];
edge [color="#64748B", penwidth=1.1, arrowsize=0.65];
graph [nodesep="0.35", ranksep="0.55"];
"rh_classical" [label="Classical properties of zeta\nCited input", fillcolor="#E8F0FC", color="#3566A0", fontcolor="#173D70"];
"rh_qrh" [label="Uniform quasi-RH estimate\nFor the auxiliary characters\nCited input", fillcolor="#E8F0FC", color="#3566A0", fontcolor="#173D70"];
"rh_four" [label="Four-character arithmetic identity\nThe conductor-one specialization\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"rh_data" [label="One compatible construction\nIntegral maps, heights and traces\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"rh_transfer" [label="Compare thick and thin weights\nPositivity removes weight symmetry\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"rh_companion" [label="Bound the quadratic companion\nAn optional separate estimate\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"rh_bound" [label="A small averaged prime-sum bound\nCombine the signed arithmetic\nterms\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"rh_criterion" [label="The one-sided prime-sum criterion\nLocal averaging preserves zero\ndetection\nWritten reduction", fillcolor="#E3F3E8", color="#267047", fontcolor="#17472E"];
"rh_goal" [label="The Riemann hypothesis\nOpen obligation", fillcolor="#FCE6E6", color="#B44444", fontcolor="#792828"];
"rh_four" -> "rh_data";
"rh_four" -> "rh_companion";
"rh_qrh" -> "rh_companion";
"rh_data" -> "rh_transfer";
"rh_data" -> "rh_bound";
"rh_transfer" -> "rh_bound";
"rh_companion" -> "rh_bound" [style=dashed, label="optional", fontsize=9];
"rh_bound" -> "rh_criterion";
"rh_classical" -> "rh_criterion";
"rh_criterion" -> "rh_goal";
"rh_qrh" -> "rh_transfer";
{rank=same; "rh_classical"; "rh_qrh"; "rh_four";}
{rank=same; "rh_data"; "rh_companion";}
{rank=same; "rh_transfer";}
{rank=same; "rh_bound";}
{rank=same; "rh_criterion";}
{rank=same; "rh_goal";}
// Invisible edges below control layout only; they are not proof interfaces.
"rh_classical" -> "rh_qrh" [style=invis, weight=50];
"rh_qrh" -> "rh_four" [style=invis, weight=50];
"rh_data" -> "rh_companion" [style=invis, weight=50];
"rh_classical" -> "rh_data" [style=invis, weight=50];
"rh_data" -> "rh_transfer" [style=invis, weight=50];
"rh_transfer" -> "rh_bound" [style=invis, weight=50];
"rh_bound" -> "rh_criterion" [style=invis, weight=50];
"rh_criterion" -> "rh_goal" [style=invis, weight=50];
}
