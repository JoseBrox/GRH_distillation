  "additional_witnesses": [
    {
      "id": "IsLocalArtin",
      "status": "proved from ordinary local/global class field theory",
      "details": "Geometric normalization; uniqueness follows from ArtEx 8–15 with explicit Chevalley-units local-idele injection. Global uniqueness is also deduced from source fields and Chebotarev."
    },
    {
      "id": "IsDeligneEps",
      "status": "proved from Deligne Theorem 4.1 and exact rank-one normalization",
      "details": "Underlying Weil epsilon at s=1/2, self-dual measure. Identity-extension induction forces independence of N. IsLocalExt gives equality of global/local degrees; the orbit-spanning map with that dimension gives ordinary Weil induction."
    }
  ],
  "proved_translations": [
    {
      "id": "all-weil-semisimple",
      "statement": "For smooth complex Weil representations, Frobenius semisimplicity is equivalent to semisimplicity of every Weil operator.",
      "proof": "Finite inertia image; a centralizing Frobenius power; semisimple positive powers of invertible complex operators imply semisimplicity."
    },
    {
      "id": "adjacent-rank-no-inertia",
      "statement": "If rho is irreducible of dimension m+1 and tau is semisimple of dimension m, then (rho tensor tau)^I=0.",
      "proof": "An inertia overlap between irreducible Weil representations forces them to differ by an unramified twist and hence have equal dimensions."
    },
    {
      "id": "source-epsilon-forgets-monodromy",
      "statement": "Identity-extension induction forces constants to depend only on underlying Weil representations.",
      "proof": "Compare the induced pair with induction of the first parameter to itself; cancel the nonzero constant."
    },
    {
      "id": "arbitrary-invariant-linear-integral",
      "statement": "The source invariant linear functional is scalar Haar on both functions used in its equation.",
      "proof": "Cuspidal Whittaker restriction gives compact support modulo N; quotient test functions have one-dimensional algebraic coinvariants."
    },
    {
      "id": "irreducible-product-union",
      "statement": "An irreducible Q(S) times Q(T) equals Q(S union T).",
      "proof": "Triangular standard-module constituents and Grothendieck commutativity force the top union constituent into the top product."
    },
    {
      "id": "full-depth-equivalence",
      "statement": "KOne-fixed vectors are equivalent to source IsTameWD for the classical correspondence.",
      "proof": "Full depth preservation and the lattice-chain radical containment; source wild inertia acts trivially on every valuation graded piece."
    }
  ],
  "critical_normalization": "The source induction relation ignores monodromy. Its IsDeligneEps witness is the underlying-Weil epsilon constant at s=1/2, with self-dual additive measure. Adjacent-rank cuspidal pairs have no inertia invariants, so neither their L-factors nor the WD monodromy correction changes the corresponding functional equation.",
