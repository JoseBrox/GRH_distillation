      "id": "zero_monodromy_dominance",
      "statement": "For Frobenius-semisimple WD representations X prec Y in the BLGGT monodromy order, N_Y=0 implies X isomorphic to Y.",
      "proof": [
        "Target special-block lengths in each unramified-twist class are all 1.",
        "The first partition inequality bounds the largest source length by 1; all positive lengths are 1.",
        "Thus source monodromy is zero; common semisimplification then gives the full isomorphism."
      ],
      "uniformity": "All finite ranks, including 1; empty classes are vacuous.",
      "verification": "Human proof; not a Lean rebuild."
    },
    {
      "id": "one_modulus_kills_monodromy",
      "statement": "F invertible, F N F^{-1}=cN, |c|!=1 and one common absolute value of all eigenvalues of F imply N=0.",
      "proof": [
        "(F-c lambda I)^m N=c^m N(F-lambda I)^m.",
        "N maps the generalized lambda-eigenspace into the generalized c lambda-eigenspace.",
        "The latter is zero because c lambda has different modulus."
      ],
      "does_not_assume": "F semisimple",
      "purity_caution": "Purity of a WD representation alone does not give one Frobenius eigenvalue modulus. Zero comparison monodromy is also needed for that route.",
      "verification": "Human proof; not a Lean rebuild."
    },
    {
      "id": "good_preimage_transfers_weak_correspondence",
      "statement": "Let R and r satisfy IsRecT. If r(x)=y=R(z) and Good(z), then x=z.",
      "proof": [
        "RecTUnique gives r(z)=R(z) because Good(z).",
        "LawsT.inj applied to r(x)=r(z) and Good(z) gives x=z."
      ],
