  "results": [
    {
      "id": "eventual-one-sided-zeta",
      "status": "proved ordinary-mathematics implication",
      "statement": "For 0<theta<1, either eventual bound G(x)<=C*x^theta or G(x)>=-C*x^theta excludes zeta zeros in Re(s)>theta. Constants and direction may vary along theta_j down to 1/2.",
      "proof": "Taylor–Tonelli positivity lemma, exact Mellin transform, alternating-series real nonvanishing, then functional equation.",
      "arithmetic_bound_proved": false
    },
    {
      "id": "source-conductor-one",
      "status": "proved from inspected definitions",
      "statement": "PChar.one has cyclic level KEPT={one}, psK=none and o=1, hence Level.Gm=Gz. Frame index_A0_eq_o gives A0=A and the Shares clause is automatic.",
      "sources": [
        "PrimePairSizeCondition.lean:7–19",
        "ExplicitFormulaErrorOfHostConditions.lean:32–38,105–121,135–151",
        "FrameFacts.lean:208–217"
      ]
    },
    {
      "id": "cohomology-not-vacuous",
      "status": "exact source obstruction to deleting a supplier",
      "statement": "SupplyChi still requires VWinAt one 401, whose VVle contract quantifies all coefficient primes and all positive twists below the growing cutoff; target conductor one does not imply those estimates.",
      "sources": [
        "SupplyChi.lean:8–16",
        "ExistsPageN.lean:12–49",
        "GaloisCohomology/Statement.lean:54–83"
      ]
    },
    {
      "id": "four-character-rh-quotient",
      "status": "proved finite-character specialization",
      "statement": "o=1 implies A0=A. With the actual supplier PsQ, the common-scale projection is G1+Gq-Gd-Gqd; only the signed companion Gd+Gqd-Gq needs an upper bound for the pure-zeta endpoint.",
      "sources": [
        "ConjEMemHostFIff.lean:82–83,98–101",
        "FieldChi.lean:53–58",
        "RecH.lean:10–11",
        "ChrBij.lean:21–24",
        "Analytic.lean:81–160"
      ]
    },
    {
      "id": "zero-total-mass-obstruction",
      "status": "proved finite Fourier obstruction",
      "statement": "Each source projection has coefficient sum zero, even after merging primitive inducers or taking finite cross-host linear combinations. These coefficient identities alone cannot yield a nonzero all-nonnegative combination.",
      "proof": "Character orthogonality on G/B; every selected e1(t) is nonidentity modulo B."
    },
    {
      "id": "zeta-only-centering",
      "status": "proved elementary inequality",
      "statement": "For h>=0, x-h>=1 and |y-x|<=h, |G1(y)-G1(x)| <= h*(1+log(x+h))^2.",
      "proof": "Piecewise differentiation, Lambda(n)<=log n, harmonic-sum bound, and 0<gamma<1."
    },
    {
      "id": "single-rh-arithmetic-budget",
      "status": "proved conditional reduction",
      "statement": "Under the same-map three-mean comparison, h>=0, x-h>=1 and |a_t/b-x|<=h, G1(x)<=(Ebar-Jthin)/k+Jlog+mean_t(Gd+Gqd-Gq)(a_t/b)+h*(1+log(x+h))^2. A vanishing-loss whole-window bound for this total implies RH, with auxiliary primes allowed to vary with x.",
      "construction_or_bound_proved": false,
      "required_extra_hypothesis": "Pooled empirical A-translation invariance of actual weight measures, or a different valid proof of the assumed comparison."
    },
    {
      "id": "actual-weight-symmetry-interface",
      "status": "bounded source trace; symmetry remains open",
      "statement": "Actual weights read hc(tau).e_j from independently selected points. Family interfaces align hosts and top orders but do not assert translated profiles or pooled empirical invariance.",
      "sources": [
        "QuadraticLogDerivCongr.lean:367–407",
        "DataParams₂.lean:73–74",
        "FamCore.lean:90–105,132–136",
        "AsmRec.lean:10–28"
      ]
    },
    {
      "id": "rh-growing-two-extensions",
      "status": "proved from exact kernel and source size contracts",
